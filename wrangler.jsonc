{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ondrift",
  "pages_build_output_dir": "./dist",
  "compatibility_date": "2026-08-12",
  "analytics_engine_datasets": [
    {
      "binding": "LANDING_ANALYTICS",
      "dataset": "ondrift_landing_events"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "ONDRIFT_FREE_TIER_QUOTA",
      "id": "0f2a1551829848e3a4486d4f5aa33221"
    },
    {
      "binding": "ONDRIFT_LICENSES",
      "id": "8a1aa1a19c1b4b1797061acb564ac63f"
    }
  ],
  // These are non-secret runtime variables. Set GEMINI_API_KEY, PADDLE_API_KEY,
  // PADDLE_WEBHOOK_SECRET, and RESEND_API_KEY separately with
  // `wrangler pages secret put`; never commit those secrets to this file. Fill in the
  // Paddle price id and client token for the selected environment before enabling Pro
  // checkout.
  "vars": {
    "FREE_TIER_DAILY_BUDGET": "2000",
    "ALLOWED_EXTENSION_ORIGINS": "chrome-extension://aonkgefdmgjcnhopbkeehmoacncpkeje,chrome-extension://lbefokebdhapaaglokdpaghopihlhagg",
    "PADDLE_PRICE_ID": "pri_01m0vq71n1k6kzgmfrecr9c804",
    "PADDLE_CLIENT_TOKEN": "live_d8b1671b0f79c2819e7fd206ec4",
    "PADDLE_ENVIRONMENT": "sandbox",
    "RESEND_FROM_EMAIL": "Ondrift <onboarding@resend.dev>"
  }
}
